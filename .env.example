# ============================================================
# RosterIQ — Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.
# ============================================================

# --- LLM (Google AI Studio — Gemini 2.0 Flash, free tier) ---
# Get at: https://aistudio.google.com/
# Without it the app still runs: routing falls back to keywords and answers
# show the data findings without an AI-written summary.
GOOGLE_API_KEY=your_google_api_key_here

# --- Web Search (Tavily — free tier: 1000 searches/month) ---
# Get at: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# --- LangSmith Tracing (optional) ---
# Uncomment only with a real key; tracing with a placeholder key logs errors.
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=rosteriq

# --- Storage locations (optional) ---
# Folder for the SQLite memory/thread databases and ChromaDB.
# Defaults to the project folder.
# ROSTERIQ_HOME=/absolute/path/for/runtime/files
# Override just the ChromaDB folder (default: $ROSTERIQ_HOME/memory/chromadb).
# CHROMADB_PATH=/absolute/path/to/chromadb
# Folder containing the two CSVs (default: ./data).
# ROSTERIQ_DATA_DIR=/absolute/path/to/data
