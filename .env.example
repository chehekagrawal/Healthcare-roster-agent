# ============================================================
# RosterIQ — Environment Variables
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.
# ============================================================

# --- LLM (Google AI Studio — Gemini 2.0 Flash, free tier) ---
# Get at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# --- Web Search (Tavily — free tier: 1000 searches/month) ---
# Get at: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# --- LangSmith Tracing (optional but strongly recommended for debugging) ---
# Get at: https://smith.langchain.com/
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=rosteriq

# --- Data paths (defaults, change if needed) ---
CSV1_PATH=data/roster_processing_details.csv
CSV2_PATH=data/aggregated_operational_metrics.csv

# --- Memory Storage paths ---
SQLITE_DB_PATH=memory/roster_iq_memory.db
CHROMADB_PATH=memory/chromadb
PROCEDURES_PATH=memory/procedures.json
